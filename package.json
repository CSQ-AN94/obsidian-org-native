    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.15.0",
    "d3-force": "^3.0.1",
    "esbuild": "^0.25.5",
    "happy-dom": "^17.0.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.0"
  }
